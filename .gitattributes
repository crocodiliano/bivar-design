* text=auto
# Hooks run under sh and break with CRLF line endings.
.githooks/* text eol=lf
# Reference images and fonts are bytes; never convert their line endings.
*.png binary
*.otf binary
*.ttf binary
# The .bivar files every future version must open, and their recorded
# results: never converted, so the bytes and the text stay as written.
tests/formato/*.bivar binary
tests/formato/*.txt text eol=lf

# Inputs the verifier must refuse (ADR-0024): bytes, never converted.
fuzz/verifier-refused/bivar_records/* binary
fuzz/verifier-refused/*.txt text eol=lf
# Scripts of the automatic build run under sh and python on Linux.
fuzz/*.sh text eol=lf
fuzz/*.py text eol=lf
