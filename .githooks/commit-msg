#!/bin/sh
# Reject commits without a DCO sign-off (ADR-0016).
# Enable once per clone with: git config core.hooksPath .githooks

if ! grep -qE '^Signed-off-by: .+ <.+>' "$1"; then
    cat >&2 <<'EOF'
ERROR: commit message has no "Signed-off-by:" line (DCO).
Commit again with: git commit -s
EOF
    exit 1
fi

# Golden images change only with the owner's recorded approval
# (CLAUDE.md section 6). CI runs the same check.
OWNER_EMAIL='344064416+crocodiliano@users.noreply.github.com'
if git diff --cached --name-only | grep -qE '(^|/)tests/golden/'; then
    if ! grep -E '^Golden-Approved-By: .+ <[^>]+>$' "$1" | grep -qF "<$OWNER_EMAIL>"; then
        cat >&2 <<EOF
ERROR: this commit changes tests/golden/ but has no owner approval line.
Add, after the owner has seen the image diff and approved it:
Golden-Approved-By: <owner name> <$OWNER_EMAIL>
EOF
        exit 1
    fi
fi
